---
import { responsiveImage } from '../lib/responsive-images';
import SiteLayout from '../layouts/SiteLayout.astro';
import FinancialReflection from '../components/FinancialReflection';
import { reader } from '../lib/content';
const entry = await reader.collections.pages.readOrThrow('financial-reflection');
---
<SiteLayout title={entry.seoTitle || entry.title} description={entry.description} image={entry.heroImage}>
  <FinancialReflection client:load heroImage={responsiveImage("/images/pages/financial-reflection/heroImage.webp", "(max-width: 900px) 88vw, 40vw")} />
</SiteLayout>
