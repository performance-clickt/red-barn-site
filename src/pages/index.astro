---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroGallery from '../components/ui/hero-gallery-scroll-animation';
import SourceVideo from '../components/SourceVideo.astro';
import { reader, shortTitle } from '../lib/content';
const home=await reader.singletons.homepage.readOrThrow();
const settings=await reader.singletons.settings.readOrThrow();
const posts=(await reader.collections.posts.all()).sort((a,b)=>(b.entry.date||'').localeCompare(a.entry.date||'')).slice(0,3);
---
<SiteLayout title="Red Barn Investment Counsel — Investing for Generations" home image={home.gallery[0].image}>
  <HeroGallery client:load headline={home.headline} tagline={home.tagline} gallery={home.gallery} email={settings.email} />
  <section class="intro-section section-shell" id="who-we-are"><span class="eyebrow">Who we are</span><h2>Wealth is more<br />than numbers.</h2><div class="intro-bottom"><p>{home.intro}</p><a class="text-link" href="/our-story">About us <span aria-hidden="true">↗</span></a></div></section>
  <section class="difference-section section-shell"><h2>The Red Barn<br /><span class="red">Difference.</span></h2><div class="difference-list">{home.differences.map(item=><article><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section>
  <section class="family-section section-shell"><div class="family-photo"><img src={home.gallery[1].image!} alt={home.gallery[1].alt} width="1500" height="1000" loading="lazy" /><span>The Family Meeting</span></div><div class="family-copy"><h2>{home.familyTitle}</h2><p>{home.familyBody}</p><h3>You’ll leave with:</h3><ul>{home.familyTakeaways.map(item=><li>{item}</li>)}</ul><a class="text-link" href="/family-meeting">Explore the Family Meeting <span aria-hidden="true">↗</span></a></div></section>
  <section class="seasons-section section-shell"><div class="section-heading"><h2>A strategy for<br />every season.</h2><a class="text-link" href="/seasons">Explore the seasons <span aria-hidden="true">↗</span></a></div><div class="season-grid">{[
    {title:'Sowing',body:'Building the base',image:'/images/a37a4208aa-image-gen--29-.webp',slug:'sowing'},
    {title:'Growing',body:'Compounding with purpose',image:'/images/784f53ef4e-image-gen--11-.webp',slug:'growing'},
    {title:'Harvest',body:'Turning assets into income',image:'/images/b866e48ff1-image-gen--12-.webp',slug:'harvest'},
    {title:'Legacy',body:'Seeding the next season',image:'/images/3ec85bf345-image-gen--13-.webp',slug:'legacy'},
  ].map(season=><a class="season" href={`/${season.slug}`}><img src={season.image} alt="" width="750" height="1000" loading="lazy" /><div><h3>{season.title}</h3><p>{season.body}</p><span aria-hidden="true">↗</span></div></a>)}</div></section>
  <section class="investing-section section-shell"><span class="eyebrow">How we invest</span><h2>{home.investingTitle}</h2><p class="investing-intro">{home.investingBody}</p><div class="investment-detail"><img src="/images/d51a7dfe8f-RedBarn-Difference1.webp" alt="A conversation around the table" width="1000" height="750" loading="lazy" /><div><h3>Three pillars you can count on.</h3><ol>{home.pillars.map(p=><li>{p}</li>)}</ol><a class="text-link" href="/pension-strategy">Explore our pension strategy <span aria-hidden="true">↗</span></a></div></div></section>
  <section class="onboarding section-shell"><h2>Your first<br />90 days.</h2><div>{home.steps.map((step,i)=><details open={i===0}><summary>{step.title}<span aria-hidden="true">+</span></summary><p>{step.body}</p></details>)}</div></section>
  <section class="philosophy-section section-shell" id="philosophy"><h2>Watch our philosophy.</h2><p>We have our own approach and see how we invest and why it matters for you.</p><SourceVideo title="Red Barn’s investment philosophy" url="https://video.squarespace-cdn.com/content/v1/68ba6b0bd61d5a1adbc5e9f0/1f2e4073-7c88-44e8-8857-9ac8ad7f069e/playlist.m3u8" poster="https://images.squarespace-cdn.com/content/v1/68ba6b0bd61d5a1adbc5e9f0/0bb90b38-1347-45a1-b077-420c043d4eaa/RedBarn-Thumbnail-Think.jpg?format=1500w" /></section>
  <section class="values-section section-shell"><img src={home.gallery[2].image!} alt={home.gallery[2].alt} width="900" height="1000" loading="lazy" /><div><h2>{home.quizTitle}</h2><p>{home.quizBody}</p><ul>{home.quizBenefits.map(p=><li>{p}</li>)}</ul><a class="button button-primary" href="/financial-reflection">Take the Financial Values Quiz <span aria-hidden="true">↗</span></a><p class="small-print">We’ll email your results and occasional insights. You can unsubscribe anytime.</p><p class="small-print">{settings.subscriptionConsent}</p></div></section>
  <section class="insights-section section-shell"><div class="section-heading"><h2>Perspectives<br />for the long view.</h2><a class="text-link" href="/insights">All insights <span aria-hidden="true">↗</span></a></div><div class="insight-list">{posts.map(({slug,entry})=><a href={`/insights/${slug}`}><time datetime={entry.date||''}>{entry.date ? new Date(entry.date+'T12:00:00Z').toLocaleDateString('en-CA',{month:'long',day:'numeric',year:'numeric'}) : 'Insights'}</time><h3>{shortTitle(entry.title)}</h3><span aria-hidden="true">↗</span></a>)}</div></section>
  <section class="advisor-section section-shell"><div><h2>Are you an advisor?</h2><p>{home.advisorBody}</p><a class="text-link" href="/advisor-relationships">Learn about Advisor Relationships <span aria-hidden="true">↗</span></a></div><img src="/images/c5a08db9f4-GettyImages-1887449071-1-2048x900.webp" alt="Two advisors in conversation" width="1000" height="600" loading="lazy" /></section>
</SiteLayout>
