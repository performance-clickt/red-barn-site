---
import {load} from 'cheerio';
interface Props {html:string;slug:string;image?:string|null;alt?:string|null}
const {html,slug,image,alt}=Astro.props;
const $=load(html,null,false);
const overview=slug==='our-approach';
const nodes=$.root().children().toArray();
const render=(els:typeof nodes)=>els.map(el=>$.html(el)).join('');
const firstSection=nodes.findIndex(el=>/^h[234]$/.test(el.tagName)||$(el).find('img').length>0);
const intro=render(firstSection<0?nodes:nodes.slice(0,firstSection));
const tail=firstSection<0?[]:nodes.slice(firstSection);
const cards:{title:string;body:string;photo:string;wide:boolean}[]=[];
let current={title:'',body:'',photo:'',wide:false};
const flush=()=>{if(current.title||current.body||current.photo)cards.push(current);current={title:'',body:'',photo:'',wide:false};};
for(const el of tail){
 const node=$(el);
 if(node.find('img').length){flush();current.photo=$.html(el);continue;}
 if(/^h[234]$/.test(el.tagName)){
  if(current.title&&!current.body){current.body+=`<h3>${node.html()||''}</h3>`;continue;}
  if(current.title||current.body)flush();
  current.title=node.html()||'';current.wide=el.tagName==='h2';continue;
 }
 if(el.tagName==='hr')continue;
 if(el.tagName==='ul'&&node.children('li').children('ul').length){
  // Imported nested lists are separate service topics, not one long bullet list.
  const plain=node.children('li').filter((_,li)=>!$(li).children('ul').length);
  if(plain.length)current.body+='<ul>'+plain.toArray().map(li=>$.html(li)).join('')+'</ul>';
  const pendingPhoto=(!current.title&&!current.body)?current.photo:'';
  if(pendingPhoto)current.photo='';
  flush();
  let nestedIndex=0;
  node.children('li').filter((_,li)=>!!$(li).children('ul').length).each((_,li)=>{
   const item=$(li).clone();const list=item.children('ul').remove();
   cards.push({title:item.text().trim(),body:list.toArray().map(n=>$.html(n)).join(''),photo:nestedIndex++===0?pendingPhoto:'',wide:false});
  });
  continue;
 }
 current.body+=$.html(el);
}
flush();
const services=[['Our Approach','our-approach'],['Discretionary Management','discretionary-management'],['Pension Strategy','pension-strategy'],['The Family Meeting','family-meeting']];
---
<div class:list={['approach-editorial',{'approach-overview':overview}]}>
 <section class="approach-intro"><div set:html={intro}/>{image&&<img src={image} alt={alt||''} width="1000" height="750" fetchpriority="high"/>}</section>
 <div class="approach-sections">{cards.map((card,i)=><section class:list={['approach-section',{'has-photo':!!card.photo,'is-wide':card.wide}]}>
  {card.photo&&<div class="approach-photo" set:html={card.photo}/>}
  <div class="approach-section-copy"><span class="approach-number" aria-hidden="true" data-number={String(i+1).padStart(2,'0')}/>{card.title&&<h2 set:html={card.title}/>}<div set:html={card.body}/></div>
 </section>)}</div>
 <nav class="approach-navigation" aria-label="Our approach">{services.map(([name,path])=><a href={`/${path}`} aria-current={slug===path?'page':undefined}>{name} <span aria-hidden="true">↗</span></a>)}</nav>
</div>
<style is:global>
.approach-editorial{width:88%;max-width:1120px;margin:auto;padding-bottom:64px}.approach-intro{display:grid;grid-template-columns:1fr 1fr;gap:7%;align-items:center;padding:40px 0 72px}.approach-intro>img{width:100%;height:370px;object-fit:cover}.approach-intro p{font-size:19px;line-height:1.8;margin:0 0 20px}.approach-editorial a{color:var(--red);text-decoration:underline;text-underline-offset:5px}.approach-intro p:has(a){font-size:13px}.approach-intro p:has(strong>em){font-size:12px;color:var(--muted);line-height:1.65}.approach-intro p:has(strong>em) strong{font-weight:400}.approach-intro p:has(strong>em) em{font-style:normal}
.approach-sections{display:grid;grid-template-columns:1fr 1fr;gap:32px}.approach-section{border-top:2px solid var(--red);padding:26px 0;min-width:0}.approach-number:before{content:attr(data-number)}.approach-number{display:block;color:var(--red);font-size:13px;letter-spacing:.08em;margin-bottom:22px}.approach-section h2{font-size:clamp(24px,2.8vw,34px);line-height:1.2;margin:0 0 25px;letter-spacing:-.035em}.approach-section h3{font-size:24px;line-height:1.3;margin-bottom:22px}.approach-section h2 strong{font-weight:400}.approach-section p{font-size:16px;line-height:1.8;margin:16px 0}.approach-section ul{list-style:none;padding:0;margin:0}.approach-section li{position:relative;border-top:1px solid var(--line);padding:14px 0 14px 22px;font-size:15px;line-height:1.65}.approach-section li:before{content:'—';position:absolute;left:0;color:var(--red)}.approach-section li p{font-size:15px;margin:0}.approach-section a{font-size:12px;font-family:'Space Grotesk',sans-serif}.approach-section p:has(strong>em){font-size:12px;color:var(--muted)}.approach-section p:has(strong>em) strong{font-weight:400}.approach-section p:has(strong>em) em{font-style:normal}
.approach-section.has-photo{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:7%;align-items:center;border:0;padding:20px 0}.approach-photo img{width:100%;height:360px;object-fit:cover}.approach-photo p{margin:0}.approach-section.is-wide{grid-column:1/-1;background:var(--light);padding:40px}.approach-section.is-wide h2{color:var(--red);font-size:40px}.approach-section.is-wide ul{display:grid;grid-template-columns:1fr 1fr;gap:0 32px}.approach-overview .has-photo{grid-column:auto;display:block;border-top:0;padding:0 0 24px}.approach-overview .approach-photo img{height:260px;margin-bottom:28px}.approach-overview .approach-section-copy{padding-right:16px}.approach-overview .approach-section:has(h2):nth-child(3){grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:7%;align-items:center}.approach-navigation{display:flex;gap:20px 30px;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:28px;margin-top:48px}.approach-navigation a{font-size:12px;color:var(--ink);text-decoration:none}.approach-navigation [aria-current]{color:var(--red)}
@media(max-width:760px){.approach-editorial{width:86%;padding-bottom:36px}.approach-intro{grid-template-columns:1fr;gap:24px;padding:28px 0 44px}.approach-intro>img{height:260px}.approach-intro p{font-size:17px}.approach-sections{grid-template-columns:1fr;gap:16px}.approach-section.has-photo,.approach-overview .approach-section:has(h2):nth-child(3){grid-template-columns:1fr;gap:26px}.approach-photo img{height:260px}.approach-section.is-wide{padding:26px}.approach-section.is-wide h2{font-size:30px}.approach-section.is-wide ul{grid-template-columns:1fr}.approach-section h2{font-size:27px}.approach-section p{font-size:15px}.approach-number{margin-bottom:14px}}
</style>
