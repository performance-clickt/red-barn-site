---
import galleries from '../content/page-galleries.json';
import HeroGallery from './ui/hero-gallery-scroll-animation';
interface Props { title:string; subtitle?:string; image?:string|null; alt?:string|null; links?:string[][]; }
const {title,subtitle,links}=Astro.props;
const photos=galleries[Astro.params.slug as keyof typeof galleries]||galleries.about;
---
<HeroGallery client:load variant="page" headline={title} tagline={subtitle||''} gallery={photos.map(image=>({image,alt:''}))} links={links} />
<style is:global>
.inner-hero.hero-scroll{height:137svh;margin-top:0;padding-top:0}
.inner-hero .hero-stage{height:62svh;min-height:420px}
.inner-hero .hero-gallery{grid-template-columns:repeat(10,1fr);grid-template-rows:repeat(6,1fr)}
.inner-hero .cell-0{grid-column:1/5;grid-row:1/5}.inner-hero .gallery-cell:after{content:"";position:absolute;inset:0;background:#0003}
.inner-hero .cell-1{grid-column:5/8;grid-row:1/3}
.inner-hero .cell-2{grid-column:8/11;grid-row:1/4}
.inner-hero .cell-3{grid-column:5/8;grid-row:3/7}
.inner-hero .cell-4{grid-column:1/3;grid-row:5/7}
.inner-hero .cell-5{grid-column:3/5;grid-row:5/7}
.inner-hero .cell-6{grid-column:8/11;grid-row:4/7}
.inner-hero .hero-reveal{display:flex;justify-content:center;text-align:center;padding:30px 6%;max-width:none;width:100%}
.inner-hero .page-headline{width:100%;max-width:968px}.page-headline h1,.page-cover-heading{font-family:'Work Sans',sans-serif;font-weight:400;font-size:clamp(3rem,7vw,7rem);line-height:1.04;letter-spacing:-.055em;color:var(--red);text-wrap:balance}
.page-headline>p{font-size:clamp(16px,1.7vw,23px);margin:24px auto 0;max-width:620px;line-height:1.5;text-wrap:balance}
.page-headline nav,.page-cover-links{display:flex;justify-content:center;gap:16px 26px;flex-wrap:wrap;margin-top:28px;font-size:13px}
.inner-hero .page-cover-copy{inset:0;width:100%;display:flex;align-items:center;justify-content:center;padding:30px 6%;text-align:center}.page-cover-copy .page-headline{width:100%;max-width:968px}.page-cover-copy .page-cover-heading{color:white}.page-cover-copy .page-headline>p{color:white}.inner-hero .scroll-cue{top:auto;bottom:28px;left:32px;background:var(--paper);color:var(--ink);padding:10px 18px;gap:20px}
.inner-hero .scroll-cue span{border-color:var(--line)}
.inner-hero .connect-anchor{top:65svh;scroll-margin-top:var(--header)}
.inner-hero + .page-content{padding-top:40px}
@media(max-width:640px){
.inner-hero.hero-scroll{height:132svh}.inner-hero .hero-stage{height:60svh;min-height:390px}
.inner-hero .hero-gallery{grid-template-columns:repeat(6,1fr);grid-template-rows:repeat(6,1fr)}
.inner-hero .cell-0{grid-column:1/4;grid-row:1/5}.inner-hero .cell-1{grid-column:4/7;grid-row:1/3}.inner-hero .cell-2{grid-column:4/7;grid-row:3/5}.inner-hero .cell-3{display:block;grid-column:1/4;grid-row:5/7}.inner-hero .cell-4{display:block;grid-column:4/7;grid-row:5/7}.inner-hero .cell-5,.inner-hero .cell-6{display:none}
.inner-hero .page-headline{width:100%;max-width:968px}.page-headline h1,.page-cover-heading{font-family:'Work Sans',sans-serif;font-weight:400;font-size:clamp(2.7rem,10vw,4rem)}.page-headline nav,.page-cover-links{font-size:12px;gap:12px 20px}.inner-hero .scroll-cue{left:18px;bottom:20px}
}
@media(prefers-reduced-motion:reduce){.inner-hero.hero-scroll{height:auto}.inner-hero .hero-stage{height:auto;min-height:0}.inner-hero .hero-gallery{height:45svh;min-height:280px}.inner-hero .hero-reveal{min-height:250px}.inner-hero .scroll-cue,.inner-hero .page-cover-copy{display:none}}
html:not(.js) .inner-hero.hero-scroll{height:auto}html:not(.js) .inner-hero .hero-stage{height:auto;min-height:0}html:not(.js) .inner-hero .hero-gallery{height:45svh}html:not(.js) .inner-hero .hero-reveal{min-height:250px}
</style>

<style is:global>html:not(.js) .inner-hero .page-cover-copy{display:none}</style>
