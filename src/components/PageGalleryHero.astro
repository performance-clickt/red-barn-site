---
import { reader } from '../lib/content';
interface Props { title:string; subtitle?:string; image?:string|null; alt?:string|null; links?:string[][]; }
const {title,subtitle,image,alt,links}=Astro.props;
const home=await reader.singletons.homepage.readOrThrow();
const photos=[{image:image||home.gallery[0].image,alt:alt||home.gallery[0].alt},home.gallery[1],home.gallery[3],home.gallery[2]];
---
<header class="page-gallery-hero">
  <nav class="gallery-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>{title}</span></nav>
  <div class="page-gallery-stage">
    <div class="page-gallery-photos" aria-hidden="true">{photos.map((photo,i)=><div class={`page-photo page-photo-${i}`}><img src={photo.image!} alt="" width="900" height="700" loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':'auto'} /></div>)}</div>
    <div class="page-gallery-title"><h1>{title}</h1>{subtitle && <p class="gallery-subtitle">{subtitle}</p>}{links && <nav aria-label={`${title} pages`}>{links.map(([label,url])=><a href={url}>{label} <span aria-hidden="true">↗</span></a>)}</nav>}</div>
  </div>
</header>
<style>
.page-gallery-hero{padding:30px 0 0;overflow:hidden;border-bottom:1px solid var(--line)}
.gallery-breadcrumb{display:flex;gap:16px;width:90%;margin:0 auto;color:var(--muted);font-size:12px}
.page-gallery-stage{position:relative;min-height:480px;display:grid;place-items:center;margin-top:22px;isolation:isolate}
.page-gallery-photos{position:absolute;inset:0;z-index:-1;pointer-events:none}
.page-photo{position:absolute;overflow:hidden;background:var(--light);border-radius:6px}
.page-photo img{width:100%;height:100%;object-fit:cover}
.page-photo-0{width:24%;height:61%;left:-4%;top:4%;transform:rotate(-5deg);--travel:-45px}
.page-photo-1{width:23%;height:42%;right:-3%;top:0;transform:rotate(5deg);--travel:45px}
.page-photo-2{width:16%;height:25%;left:13%;bottom:-6%;transform:rotate(4deg);--travel:-30px}
.page-photo-3{width:20%;height:36%;right:8%;bottom:-9%;transform:rotate(-5deg);--travel:40px}
.page-gallery-title{width:60%;max-width:850px;text-align:center;padding:48px 0 100px}
.page-gallery-title h1{font-size:clamp(3.5rem,7vw,7.5rem);line-height:1.02;letter-spacing:-.06em;color:var(--red);text-wrap:balance}
.gallery-subtitle{font-size:clamp(16px,1.6vw,22px);line-height:1.45;max-width:480px;margin:24px auto 0;text-wrap:balance}.page-gallery-title nav{display:flex;justify-content:center;flex-wrap:wrap;gap:16px 25px;margin:28px auto 0;max-width:560px}
.page-gallery-title nav a{font-size:13px;line-height:1.5}.page-gallery-title nav a:hover{color:var(--red)}
@supports(animation-timeline:view()){@media(prefers-reduced-motion:no-preference){.page-photo{animation:open-gallery linear both;animation-timeline:view();animation-range:exit 0% exit 100%}@keyframes open-gallery{to{translate:var(--travel) 35px}}}}
@media(min-width:1500px){.page-gallery-stage{min-height:550px}}
@media(max-width:760px){.page-gallery-hero{padding-top:24px}.gallery-breadcrumb{width:86%;font-size:11px}.page-gallery-stage{min-height:450px;margin-top:28px}.page-gallery-title{width:80%;padding:75px 0 110px}.page-gallery-title h1{font-size:clamp(2.7rem,10.5vw,4.5rem)}.page-photo-0{width:28%;height:23%;left:-7%;top:0}.page-photo-1{width:30%;height:23%;right:-5%;top:-1%}.page-photo-2{width:31%;height:22%;left:3%;bottom:-5%}.page-photo-3{width:37%;height:24%;right:0;bottom:-4%}.page-gallery-title nav{gap:10px 18px;margin-top:22px}.page-gallery-title nav a{font-size:12px}}
</style>
<style is:global>
.page-gallery-hero + .page-content{padding-top:48px}
@media(max-width:760px){.page-gallery-hero + .page-content{padding-top:32px}}
</style>
