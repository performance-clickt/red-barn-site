---
import galleries from '../content/page-galleries.json';
interface Props { title:string; subtitle?:string; image?:string|null; alt?:string|null; links?:string[][]; }
const {title,subtitle,links}=Astro.props;
const slug=Astro.params.slug as keyof typeof galleries;
const photos=galleries[slug]||galleries['about'];
---
<header class="page-gallery-hero">
  <nav class="gallery-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>{title}</span></nav>
  <div class:list={["page-gallery-stage", {"long-title":title.length>24}]}>
    <div class="page-gallery-photos" aria-hidden="true">{photos.map((photo,i)=><div class={`page-photo page-photo-${i}`}><img src={photo} alt="" width="900" height="700" loading="eager" fetchpriority={i===0?'high':'auto'} /></div>)}</div>
    <div class="page-gallery-title"><h1>{title}</h1>{subtitle && <p class="gallery-subtitle">{subtitle}</p>}{links && <nav aria-label={`${title} pages`}>{links.map(([label,url])=><a href={url}>{label} <span aria-hidden="true">↗</span></a>)}</nav>}</div>
  </div>
</header>
<style>
.page-gallery-hero{padding:30px 0 0;overflow:hidden;border-bottom:1px solid var(--line)}
.gallery-breadcrumb{display:flex;gap:16px;width:90%;margin:0 auto;color:var(--muted);font-size:12px}
.page-gallery-stage{position:relative;min-height:480px;width:94%;max-width:1100px;margin-inline:auto;display:grid;place-items:center;margin-top:22px;isolation:isolate}
.page-gallery-photos{position:absolute;inset:0;z-index:-1;pointer-events:none}
.page-photo{position:absolute;overflow:hidden;background:var(--light);border-radius:0}
.page-photo img{width:100%;height:100%;object-fit:cover}
.page-photo-0{width:19%;height:42%;left:3%;top:29%}
.page-photo-1{width:19%;height:42%;right:3%;top:29%}
.page-photo-2{width:29%;height:22%;left:35.5%;top:0}
.page-photo-3{width:29%;height:22%;left:35.5%;bottom:0}
.page-gallery-title{width:52%;max-width:850px;text-align:center;padding:36px 0}
.page-gallery-title h1{font-size:clamp(3rem,6vw,6.5rem);line-height:1.02;letter-spacing:-.06em;color:var(--red);text-wrap:balance}
.gallery-subtitle{font-size:clamp(16px,1.6vw,22px);line-height:1.45;max-width:480px;margin:24px auto 0;text-wrap:balance}.page-gallery-title nav{display:flex;justify-content:center;flex-wrap:wrap;gap:16px 25px;margin:28px auto 0;max-width:560px}
.page-gallery-title nav a{font-size:13px;line-height:1.5}.page-gallery-title nav a:hover{color:var(--red)}
.page-gallery-stage.long-title{min-height:600px}
@media(max-width:760px){.page-gallery-hero{padding-top:24px}.gallery-breadcrumb{width:86%;font-size:11px}.page-gallery-stage,.page-gallery-stage.long-title{min-height:530px;margin-top:28px;width:100%}.page-gallery-title{width:86%;padding:140px 0}.page-gallery-title h1{font-size:clamp(2.7rem,10.5vw,4.5rem)}.page-photo-0{width:42%;height:21%;left:6%;top:0}.page-photo-1{width:42%;height:21%;right:6%;top:0}.page-photo-2{width:42%;height:21%;left:6%;bottom:0;top:auto}.page-photo-3{width:42%;height:21%;left:auto;right:6%;bottom:0}.page-gallery-title nav{gap:10px 18px;margin-top:22px}.page-gallery-title nav a{font-size:12px}}
</style>
<style is:global>
.page-gallery-hero + .page-content{padding-top:48px}
@media(max-width:760px){.page-gallery-hero + .page-content{padding-top:32px}}
</style>

<script>
  import { scroll } from 'motion';
  function openPageGallery() {
    const stage=document.querySelector<HTMLElement>('.page-gallery-stage');
    if(!stage || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const photos=stage.querySelectorAll<HTMLElement>('.page-photo');
    const compact=matchMedia('(max-width:760px)').matches;
    const directions=compact?[[-60,-60],[60,-60],[-60,60],[60,60]]:[[-130,0],[130,0],[0,-90],[0,90]];
    photos.forEach((photo,i)=>{
      const [x,y]=directions[i];
      photo.animate([
        {transform:`translate(${-x*.12}px,${-y*.12}px)`,opacity:0},
        {transform:'translate(0,0)',opacity:1}
      ],{duration:850,delay:i*60,easing:'cubic-bezier(.22,1,.36,1)',fill:'backwards'});
    });
    const stopScroll=scroll((progress:number)=>{
      photos.forEach((photo,i)=>{const [x,y]=directions[i];photo.style.translate=`${progress*x}px ${progress*y}px`;});
    },{target:stage,offset:['start start','end start']});
    document.addEventListener('astro:before-swap',stopScroll,{once:true});
    stage.querySelector('.page-gallery-title')?.animate([
      {opacity:0,transform:'translateY(24px)'},{opacity:1,transform:'translateY(0)'}
    ],{duration:700,delay:0,easing:'ease-out',fill:'backwards'});
  }
  openPageGallery();
  document.addEventListener('astro:after-swap',openPageGallery);
</script>
