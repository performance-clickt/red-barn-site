---
interface Props { title:string; subtitle?:string; image?:string|null; alt?:string|null; links?:string[][]; }
const {title,subtitle,links}=Astro.props;
---
<header class="simple-page-hero">
  <h1>{title}</h1>
  {subtitle && <p>{subtitle}</p>}
  {links && <nav aria-label={`${title} pages`}>{links.map(([label,url])=><a href={url}>{label} <span aria-hidden="true">↗</span></a>)}</nav>}
</header>
<style>
.simple-page-hero{width:88%;max-width:1120px;margin:0 auto;padding:76px 0 48px;border-bottom:1px solid var(--line)}
h1{max-width:1000px;font-size:clamp(3rem,6vw,6rem);line-height:1.06;letter-spacing:-.055em;color:var(--red);text-wrap:balance}
p{max-width:760px;font-size:clamp(18px,2vw,25px);line-height:1.5;margin-top:24px;text-wrap:pretty}
nav{display:flex;flex-wrap:wrap;gap:16px 28px;margin-top:30px;font-size:13px}nav a:hover{color:var(--red)}
@media(max-width:760px){.simple-page-hero{width:86%;padding:44px 0 30px}h1{font-size:clamp(2.6rem,10vw,4rem)}p{margin-top:18px}nav{gap:12px 20px;margin-top:24px}}
</style>
<style is:global>.simple-page-hero + .page-content{padding-top:40px}@media(max-width:760px){.simple-page-hero + .page-content{padding-top:28px}}</style>
