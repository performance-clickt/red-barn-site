{
  "name": "red-barn-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/emdash/restore-baseline-images.mjs && node scripts/performance/prepare-images.mjs && astro check && astro build && node scripts/prepare-seo.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "audit:content": "node scripts/audit-content.mjs",
    "test:reflection": "node --experimental-strip-types --test tests/reflection/*.test.mjs",
    "cms:import": "node scripts/emdash/import-content.mjs",
    "cms:seed": "node scripts/emdash/generate-seed.mjs",
    "test:cms": "node --test tests/emdash/*.test.mjs",
    "audit:schema": "node scripts/audit-schema.mjs",
    "test:schema": "node --experimental-strip-types --test tests/seo/*.test.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "sharp": "0.35.5",
    "turndown": "7.2.4",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@astrojs/node": "11.1.8",
    "@astrojs/react": "6.0.5",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/work-sans": "5.3.0",
    "@markdoc/markdoc": "0.5.9",
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-slot": "1.3.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "emdash": "1.3.0",
    "hls.js": "1.7.3",
    "kysely": "0.29.6",
    "motion": "13.3.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "emdash": {
    "seed": "seed/model.json"
  }
}
